{
  "manifest_version": 3,
  "name": "SlideShots",
  "version": "0.4.4",
  "description": "ページ全体や内部スクロール・iframeを1回の操作で撮影。PNG・JPEG・WebP・A4縦PDFに保存できます。",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "minimum_chrome_version": "125",
  "permissions": ["downloads", "offscreen", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "SlideShots", "default_popup": "popup.html", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["frame-agent.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
